{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "njmtech-upload-blob",
	"main": "worker.py",
	"compatibility_date": "2025-11-02",
	"compatibility_flags": [
		"python_workers",
		"python_dedicated_snapshot"
	],
	"triggers": {
		"crons": ["0 */6 * * *"]
	},
	"vars": {
		"BLOB_PREFIX": "njmtech-blob-api/"
	},
	"kv_namespaces": [
		{
			"binding": "UPLOAD_BLOB_CACHE",
			"id": "ef7d631cb7b446a59d6382be4417e4ce"
		}
	],
	"observability": {
		"enabled": true
	},
	"routes": [
    {
      "pattern": "api.blob.njmtech.co.za",
      "custom_domain": true
    }
  ]

}
